# 大模型 API 配置
# 支持 OpenAI 兼容 API
API_BASE_URL=https://api.openai.com/v1
API_KEY=your_api_key_here
MODEL_ID=gpt-4o-mini

# API 重试配置
# 当 JSON 格式验证失败时的最大重试次数
MAX_RETRIES=3

# 模型输出 token 限制（建议 2000-4000，思维链模型可能需要更多）
# 注意：思维链模型的 reasoning 不计入此限制
MAX_COMPLETION_TOKENS=2000

# Git 推送重试配置
# 推送失败时的最大重试次数（针对网络错误如 SSL/TLS 连接失败）
PUSH_RETRIES=3
# 重试之间的延迟时间（秒）
RETRY_DELAY=2

# 远程仓库配置
# 仅支持 GitHub 仓库地址
REMOTE_ORIGIN=https://github.com/your_username/your_repo.git

# Git 多用户配置
# JSON 数组格式，支持配置多个用户及对应的 GitHub Token
# 脚本会在运行时让用户选择使用哪个身份提交和推送
#
# 字段说明:
#   name:  提交时显示的用户名
#   email: 提交时显示的邮箱
#   token: GitHub Personal Access Token (需要 repo 权限)
#
# 注意: JSON 字符串建议保持在一行，或者确保换行符被正确解析
# 示例 (单个用户):
# GIT_USERS=[{"name": "User1", "email": "user1@example.com", "token": "ghp_your_token_here"}]
# 示例 (多个用户):
# GIT_USERS=[{"name": "User1", "email": "user1@example.com", "token": "ghp_token1"}, {"name": "User2", "email": "user2@example.com", "token": "ghp_token2"}]
GIT_USERS=[{"name": "YourName", "email": "your_email@example.com", "token": "ghp_your_github_token_here"}]

# 其他配置
# 提交前确认 (true/false)
CONFIRM_BEFORE_COMMIT=true