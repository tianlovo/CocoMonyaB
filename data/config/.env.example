# Telegram API 配置
# 请在 https://my.telegram.org 申请以下信息
# 复制此文件为 .env 并填入你的真实值

# API ID - 纯数字格式
# 示例: 12345678
API_ID=your_api_id

# API Hash - 32位十六进制字符
# 示例: 0123456789abcdef0123456789abcdef
API_HASH=your_api_hash

# 登录配置
# 手机号 - 必须以 + 开头，包含国家代码
# 示例: +8613800138000
TG_PHONE=+8613800138000

# 两步验证密码（如果启用了 2FA）
# 如果未启用 2FA，可以留空或删除此行
TG_2FA=your_2fa_password_if_enabled

# 用于WS客户端认证的Token（随机字符串，至少32位）
WS_TRUSTED_TOKEN=default-secure-token-change-me
